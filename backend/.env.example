# ---- Backend environment (PLACEHOLDERS ONLY — no real secrets) ----

# MongoDB connection string (local or Atlas). Do NOT commit the real value.
# Only used when USE_PG="false". With USE_PG="true" the backend never connects to Mongo
# (MONGO_URL/DB_NAME can be removed) -- see docs/SUPABASE_MIGRATION_PLAN.md, Phase 2.
MONGO_URL="mongodb://localhost:27017"

# Database name. Use a separate DB for demo vs operational (see docs/DATA_SEPARATION.md).
DB_NAME="berts_ops"

# ---- Supabase (Postgres) — target of the MongoDB migration. Get these values from
# your project's Settings > API / Database pages.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
# Use the Shared pooler, Transaction mode (IPv4): Project > Connect > Shared pooler. The
# direct db.<ref>.supabase.co host is IPv6-only and fails from most hosts.
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres"
# Optional separate backend account/notification role. Leave UNSET for existing
# single-pool compatibility. Before changing DATABASE_URL to the inventory role,
# configure AUXILIARY_DATABASE_URL with its separately reviewed narrow LOGIN.
# It must use the SAME host, port, database and Supabase project as DATABASE_URL.
# Configured but empty/invalid/unavailable values hold these routes with 503;
# there is no fallback. See docs/AUXILIARY_CONNECTION_CHECKPOINT.md.
# AUXILIARY_DATABASE_URL="postgresql://account-role.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres"
# Backend-side counterpart to the frontend's REACT_APP_USE_PG (frontend/.env). Set both
# together -- the frontend flag alone can't make server-side code (Owner Dashboard,
# the AI Assistant, PO receiving, manager Enter Counts) follow the cutover; this is
# what does. See docs/SUPABASE_MIGRATION_PLAN.md, chunk 5.5.
USE_PG="true"
# Review-only purchase foundation. Apply the native migration to a disposable DB
# before enabling; see docs/NATIVE_PURCHASE_IMPORT.md for cutover gates.
PURCHASE_IMPORT_ENABLED="false"
# Physical purchased-item counts with explicit count values; second migration.
ACTUAL_INVENTORY_ENABLED="false"

# Comma-separated allowed origins for CORS. Use explicit origins in production.
CORS_ORIGINS="https://your-frontend.example.com"

# Collaboration security. AUTH_SECRET must be a long random value in production.
AUTH_REQUIRED="true"
# Prep definition review only; requires Postgres and native purchases.
PREP_SETUP_ENABLED=false
# Versioned standing prep planning only; requires prep setup and catalog mapping.
PREP_PLANNING_ENABLED=false
PREP_DAY_TASKS_ENABLED=false
PREP_EXECUTION_ENABLED=false
STAFF_PREP_COUNTS_ENABLED=false
AUTH_SECRET="replace-with-at-least-32-random-characters"
# One-time secret used to create the first owner account, then remove/rotate it.
BOOTSTRAP_TOKEN="replace-with-a-one-time-bootstrap-secret"
SESSION_TTL_SECONDS="28800"
RATE_LIMIT_PER_MINUTE="60"

# Anthropic API key — powers the "Sous" AI assistant and the par advisor (Claude).
# Create at console.anthropic.com > API Keys; keep secret. ANTHROPIC_MODEL is optional.
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX"
# Only if the key is organization-level (not scoped to a workspace): the workspace id to bill.
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."
# ANTHROPIC_MODEL="claude-opus-5-5"

# Resend API key — powers supplier PO emails. EMAIL_FROM_ADDRESS must be on a domain
# verified in Resend (Domains > Add domain, then add its DNS records).
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
EMAIL_FROM_ADDRESS="orders@your-domain.example.com"

# Sender display name on supplier emails (your business/brand).
EMAIL_FROM_NAME="Your Restaurant Group"

# First-party HTTPS origin of THIS backend. Used to build the PO-PDF link embedded
# in supplier emails. MUST be https and a domain you control (never a request header).
PUBLIC_APP_URL="https://your-app-domain.example.com"

# Quantity-only native prep batch pilot; requires reviewed prep setup.
PREP_BATCHES_ENABLED=false

# Standalone waste and full physical prep observations; requires batch pilot.
PREP_OBSERVATIONS_ENABLED=false
PREP_CONTAINERS_ENABLED=false
STAFF_PREP_TASKS_ENABLED=false
CATALOG_MAPPING_ENABLED=false
ORDER_WORKFLOW_ENABLED=false
SUPPLIER_CONTACTS_ENABLED=false
STAFF_PREP_PRODUCTION_ENABLED=false
