# ---- Backend environment (PLACEHOLDERS ONLY — no real secrets) ----

# MongoDB connection string (local or Atlas). Do NOT commit the real value.
MONGO_URL="mongodb://localhost:27017"

# Database name. Use a separate DB for demo vs operational (see docs/DATA_SEPARATION.md).
DB_NAME="berts_ops"

# Comma-separated allowed origins for CORS. Use explicit origins in production.
CORS_ORIGINS="*"

# Emergent Universal LLM key — powers the "Sous" AI assistant (OpenAI GPT-4o).
# Obtain from your Emergent profile; keep secret.
EMERGENT_LLM_KEY="sk-emergent-XXXXXXXXXXXXXXXXX"

# Emergent-managed Resend email key — powers supplier PO emails.
EMERGENT_EMAIL_KEY="ek_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Sender display name on supplier emails (your business/brand).
EMAIL_FROM_NAME="Your Restaurant Group"

# First-party HTTPS origin of THIS backend. Used to build the PO-PDF link embedded
# in supplier emails. MUST be https and a domain you control (never a request header).
PUBLIC_APP_URL="https://your-app-domain.example.com"
