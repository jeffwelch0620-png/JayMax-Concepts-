# ---- Frontend environment (PLACEHOLDERS ONLY) ----

# Origin of the backend API. The app calls `${REACT_APP_BACKEND_URL}/api/...`.
# No trailing slash. In dev this is typically http://localhost:8001
REACT_APP_BACKEND_URL="https://your-app-domain.example.com"

# Dev websocket port for CRA hot reload behind an https proxy (leave as-is if unsure).
WDS_SOCKET_PORT=443

# Platform health-check toggle (safe to leave false locally).
ENABLE_HEALTH_CHECK=false

# Native purchase review build. Keep disabled until schema/testing and reporting
# cutover gates in docs/NATIVE_PURCHASE_IMPORT.md are complete.
REACT_APP_NATIVE_PURCHASES=false
REACT_APP_ACTUAL_INVENTORY=false
REACT_APP_PREP_SETUP=false
REACT_APP_PREP_PLANNING=false
REACT_APP_PREP_DAY_TASKS=false
REACT_APP_PREP_EXECUTION=false

# Quantity-only native prep batch pilot; requires reviewed prep setup.
REACT_APP_PREP_BATCHES=false

# Standalone waste and full physical prep observations; requires batch pilot.
REACT_APP_PREP_OBSERVATIONS=false
REACT_APP_CATALOG_MAPPING=false
REACT_APP_ORDER_WORKFLOW=false
REACT_APP_SUPPLIER_CONTACTS=false
